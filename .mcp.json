{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--browser",
        "chromium",
        "--headless",
        "--executable-path",
        "/opt/pw-browsers/chromium"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "markitdown": {
      "command": "markitdown-mcp",
      "args": []
    }
  }
}
